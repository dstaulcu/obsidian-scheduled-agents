{
  "name": "scheduled-agents",
  "version": "0.1.0",
  "description": "Scheduled AI agent jobs for your Obsidian vault: built-in jobs plus your own custom prompts and output folders, results written by the plugin, tag edits applied only after approval.",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc --noEmit && node esbuild.config.mjs production",
    "type:check": "tsc --noEmit",
    "test": "jest",
    "bump": "node scripts/release.mjs --bump-only",
    "bump:minor": "node scripts/release.mjs minor --bump-only",
    "bump:major": "node scripts/release.mjs major --bump-only",
    "release": "node scripts/release.mjs",
    "release:minor": "node scripts/release.mjs minor",
    "release:major": "node scripts/release.mjs major",
    "deploy": "node scripts/deploy.mjs --build",
    "reset:test": "node scripts/reset-test.mjs --deploy",
    "tag": "node scripts/tag-release.mjs"
  },
  "license": "MIT",
  "devDependencies": {
    "@types/jest": "^29.5.12",
    "@types/node": "^20.14.0",
    "builtin-modules": "^3.3.0",
    "esbuild": "^0.21.5",
    "jest": "^29.7.0",
    "obsidian": "latest",
    "ts-jest": "^29.1.5",
    "tslib": "^2.6.3",
    "typescript": "^5.5.2"
  }
}
